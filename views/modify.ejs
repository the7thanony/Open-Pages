<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Write — Open Pages' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="flash-container" id="flashContainer">
    <%- include('partials/flash') %>
  </div>

  <main class="main-content">
    <div class="form-page fade-in">
      <a href="/" class="back-link" id="backLink">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back to posts
      </a>

      <div class="form-card">
        <div class="form-card__header">
          <h1 class="form-title"><%= heading %></h1>
          <p class="form-subtitle">
            <% if (post && post.id) { %>
              Make your changes and update your post.
            <% } else { %>
              Share your thoughts with the world.
            <% } %>
          </p>
        </div>

        <form
          method="POST"
          action="<%= post && post.id ? '/edit/' + post.id : '/new' %>"
          class="form"
          id="postForm"
        >
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Title Field -->
          <div class="form-group" id="titleGroup">
            <label for="titleInput" class="form-label">Title</label>
            <input
              type="text"
              id="titleInput"
              name="title"
              class="form-input"
              placeholder="Give your post a compelling title..."
              value="<%= post ? post.title : '' %>"
              required
              minlength="3"
              maxlength="300"
            >
            <div class="form-helper">
              <span class="helper-text">3–300 characters</span>
              <span class="char-count" id="titleCharCount">0/300</span>
            </div>
          </div>

          <!-- Content Field -->
          <div class="form-group" id="contentGroup">
            <label for="contentInput" class="form-label">Content</label>
            <textarea
              id="contentInput"
              name="content"
              class="form-input form-textarea"
              placeholder="Write your post content here..."
              rows="14"
              required
              minlength="10"
            ><%= post ? post.content : '' %></textarea>
            <div class="form-helper">
              <span class="helper-text">Minimum 10 characters</span>
              <span class="char-count" id="contentCharCount">0</span>
            </div>
          </div>

          <!-- Status Toggle -->
          <div class="form-group" id="statusGroup">
            <label class="form-label">Status</label>
            <div class="status-toggle">
              <label class="toggle-option">
                <input type="radio" name="status" value="published" <%= (!post || post.status === 'published') ? 'checked' : '' %>>
                <span class="toggle-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  Published
                </span>
              </label>
              <label class="toggle-option">
                <input type="radio" name="status" value="draft" <%= (post && post.status === 'draft') ? 'checked' : '' %>>
                <span class="toggle-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                    <line x1="1" y1="1" x2="23" y2="23"></line>
                  </svg>
                  Draft
                </span>
              </label>
            </div>
            <span class="helper-text">Drafts are only visible to you.</span>
          </div>

          <!-- Submit Button -->
          <div class="form-actions">
            <a href="/" class="btn btn--ghost" id="cancelBtn">Cancel</a>
            <button type="submit" class="btn btn--primary btn--lg" id="submitBtn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              <%= submit %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>