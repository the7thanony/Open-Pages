<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Search — Open Pages' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="flash-container" id="flashContainer">
    <%- include('partials/flash') %>
  </div>

  <main class="main-content">
    <section class="posts-section fade-in">
      <div class="section-header">
        <h1 class="section-title">
          <% if (search) { %>
            Results for "<span class="gradient-text"><%= search %></span>"
          <% } else { %>
            Explore Posts
          <% } %>
        </h1>
      </div>

      <% if (posts.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🔍</div>
          <h3 class="empty-title">
            <% if (search) { %>
              No results found
            <% } else { %>
              Start searching
            <% } %>
          </h3>
          <p class="empty-text">
            <% if (search) { %>
              Try different keywords or <a href="/search" class="auth-link">browse all posts</a>.
            <% } else { %>
              Enter a search term to find posts by title or author.
            <% } %>
          </p>
        </div>
      <% } else { %>
        <div class="posts-grid">
          <% posts.forEach((post, index) => { %>
            <article class="post-card fade-in" style="animation-delay: <%= index * 0.08 %>s" id="search-post-<%= post.id %>">
              <div class="post-card__header">
                <div class="post-card__meta">
                  <div class="author-chip">
                    <span class="author-avatar"><%= getInitials(post.author || 'Unknown') %></span>
                    <span class="author-name"><%= post.author || 'Unknown' %></span>
                  </div>
                  <span class="meta-dot">·</span>
                  <time class="post-date" datetime="<%= post.created_at %>"><%= timeAgo(post.created_at) %></time>
                </div>
              </div>

              <a href="/post/<%= post.id %>" class="post-card__body">
                <h3 class="post-card__title"><%= post.title %></h3>
                <p class="post-card__excerpt"><%= truncate(post.content, 180) %></p>
              </a>

              <div class="post-card__footer">
                <span class="reading-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <%= readingTime(post.content) %>
                </span>
              </div>
            </article>
          <% }); %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <nav class="pagination" aria-label="Page navigation" id="pagination">
            <% if (pagination.hasPrev) { %>
              <a href="/search?q=<%= search %>&page=<%= pagination.page - 1 %>" class="pagination-btn">← Previous</a>
            <% } %>
            <span class="pagination-info">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
            <% if (pagination.hasNext) { %>
              <a href="/search?q=<%= search %>&page=<%= pagination.page + 1 %>" class="pagination-btn">Next →</a>
            <% } %>
          </nav>
        <% } %>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
