<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'My Posts — Open Pages' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <%- include('partials/header') %>

  <div class="flash-container" id="flashContainer">
    <%- include('partials/flash') %>
  </div>

  <main class="main-content">
    <section class="posts-section fade-in">
      <div class="section-header">
        <h1 class="section-title">My Posts</h1>
        <a href="/new" class="btn btn--primary" id="newPostBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          New Post
        </a>
      </div>

      <!-- Status Filter Tabs -->
      <div class="filter-tabs" id="filterTabs">
        <a href="/my-posts" class="filter-tab <%= statusFilter === 'all' ? 'active' : '' %>">All</a>
        <a href="/my-posts?status=published" class="filter-tab <%= statusFilter === 'published' ? 'active' : '' %>">Published</a>
        <a href="/my-posts?status=draft" class="filter-tab <%= statusFilter === 'draft' ? 'active' : '' %>">Drafts</a>
      </div>

      <% if (posts.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">📝</div>
          <h3 class="empty-title">
            <% if (statusFilter === 'draft') { %>
              No drafts yet
            <% } else if (statusFilter === 'published') { %>
              No published posts yet
            <% } else { %>
              No posts yet
            <% } %>
          </h3>
          <p class="empty-text">Start writing your first post and share it with the world!</p>
          <a href="/new" class="btn btn--primary">Write a Post</a>
        </div>
      <% } else { %>
        <div class="posts-grid">
          <% posts.forEach((post, index) => { %>
            <article class="post-card fade-in" style="animation-delay: <%= index * 0.08 %>s" id="my-post-<%= post.id %>">
              <div class="post-card__header">
                <div class="post-card__meta">
                  <time class="post-date" datetime="<%= post.created_at %>"><%= timeAgo(post.created_at) %></time>
                </div>
                <% if (post.status === 'draft') { %>
                  <span class="badge badge--draft">Draft</span>
                <% } else { %>
                  <span class="badge badge--published">Published</span>
                <% } %>
              </div>

              <a href="/post/<%= post.id %>" class="post-card__body">
                <h3 class="post-card__title"><%= post.title %></h3>
                <p class="post-card__excerpt"><%= truncate(post.content, 150) %></p>
              </a>

              <div class="post-card__footer">
                <span class="reading-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                  <%= readingTime(post.content) %>
                </span>
                <div class="card-actions">
                  <a href="/edit/<%= post.id %>" class="btn btn--ghost btn--xs" title="Edit">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                  </a>
                  <form action="/delete/<%= post.id %>" method="POST" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn--danger btn--xs" title="Delete" onclick="return confirm('Delete this post?')">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                      </svg>
                    </button>
                  </form>
                </div>
              </div>
            </article>
          <% }); %>
        </div>

        <!-- Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <nav class="pagination" aria-label="Page navigation" id="pagination">
            <% if (pagination.hasPrev) { %>
              <a href="/my-posts?page=<%= pagination.page - 1 %>&status=<%= statusFilter %>" class="pagination-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Previous
              </a>
            <% } else { %>
              <span class="pagination-btn pagination-btn--disabled">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                Previous
              </span>
            <% } %>

            <span class="pagination-info">Page <%= pagination.page %> of <%= pagination.totalPages %></span>

            <% if (pagination.hasNext) { %>
              <a href="/my-posts?page=<%= pagination.page + 1 %>&status=<%= statusFilter %>" class="pagination-btn">
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            <% } else { %>
              <span class="pagination-btn pagination-btn--disabled">
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </span>
            <% } %>
          </nav>
        <% } %>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
</body>
</html>
