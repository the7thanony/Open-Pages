{
  "name": "open-pages",
  "version": "2.0.0",
  "description": "A full-stack blog platform built with Node.js, Express, PostgreSQL, and EJS",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "nodemon src/api/index.js",
    "dev:web": "nodemon src/web/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/migrate.js seed",
    "db:fresh": "node src/db/migrate.js fresh",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"views/**/*.ejs\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "start:api": "node src/api/index.js",
    "start:web": "node src/web/index.js"
  },
  "keywords": ["blog", "express", "postgresql", "ejs"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^9.0.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "express-session": "^1.17.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "sanitize-html": "^2.11.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  }
}
